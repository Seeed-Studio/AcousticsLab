# AcousticsLab Web daemon configuration (systemd EnvironmentFile).
# Edited in place; preserved across package upgrades (dpkg conffile).

# TCP address the web console listens on.
# Loopback-only by default: the daemon control plane has no auth/CORS, so it
# must not be published to the LAN unfronted. To expose it, put it behind a
# reverse proxy that owns TLS/auth, or (understanding the risk) set
# 0.0.0.0:<port> here. Ports < 1024 work (the unit grants CAP_NET_BIND_SERVICE).
ACOUSTICSLAB_WEB_LISTEN=127.0.0.1:8080

# The acousticslabd API Unix socket to reverse-proxy to (matches
# `[api].uds_path` in /etc/acousticslab/launch.toml).
ACOUSTICSLAB_API_SOCKET=/run/acousticslab/api.sock

# Directory holding the built SPA (index.html + _app/...).
ACOUSTICSLAB_WEB_ROOT=/usr/share/acousticslab/web

# tracing filter: error | warn | info | debug | trace.
ACOUSTICSLAB_WEB_LOG=info
